<?xml version="1.0" encoding="UTF-8"?>
<!--
  A DMN 1.3 document in the shape Camunda Modeler exports: the older MODEL
  namespace, a `camunda:` vendor namespace on the root, DMNDI diagram elements
  Verdict ignores, `biodi`/`camunda` extension attributes, and no explicit
  conformance level.

  This is the file that proves success criterion 1: a model authored in a
  third-party editor loads and evaluates without being touched.
-->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:camunda="http://camunda.org/schema/1.0/dmn"
             id="dish"
             name="Dish"
             namespace="http://camunda.org/schema/1.0/dmn"
             exporter="Camunda Modeler"
             exporterVersion="5.19.0">

  <decision id="dish-decision" name="Dish Decision">
    <informationRequirement id="InformationRequirement_1">
      <requiredDecision href="#season"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_2">
      <requiredDecision href="#guestCount"/>
    </informationRequirement>
    <decisionTable id="dishDecisionTable">
      <input id="InputClause_0agmc3l" label="Season">
        <inputExpression id="LiteralExpression_0bqgrlg" typeRef="string">
          <text>season</text>
        </inputExpression>
      </input>
      <input id="InputClause_1cthd0w" label="How many guests">
        <inputExpression id="LiteralExpression_0nhiedd" typeRef="integer">
          <text>guestCount</text>
        </inputExpression>
      </input>
      <output id="OutputClause_0lohv3s" label="Dish" name="desiredDish" typeRef="string"/>
      <rule id="row-495762709-1">
        <inputEntry id="UnaryTests_0c1o054"><text>"Fall"</text></inputEntry>
        <inputEntry id="UnaryTests_1bbf8mv"><text>&lt;= 8</text></inputEntry>
        <outputEntry id="LiteralExpression_0nhcrpg"><text>"Spareribs"</text></outputEntry>
      </rule>
      <rule id="row-495762709-2">
        <inputEntry id="UnaryTests_0nhs8kn"><text>"Winter"</text></inputEntry>
        <inputEntry id="UnaryTests_1flhz9h"><text>&lt;= 8</text></inputEntry>
        <outputEntry id="LiteralExpression_1kb1s5c"><text>"Roastbeef"</text></outputEntry>
      </rule>
      <rule id="row-495762709-3">
        <inputEntry id="UnaryTests_18ivszm"><text>"Spring"</text></inputEntry>
        <inputEntry id="UnaryTests_1ivrbmy"><text>&lt;= 4</text></inputEntry>
        <outputEntry id="LiteralExpression_18ivszm"><text>"Dry Aged Gourmet Steak"</text></outputEntry>
      </rule>
      <rule id="row-495762709-4">
        <description>Save money</description>
        <inputEntry id="UnaryTests_1lqrlvt"><text>"Spring"</text></inputEntry>
        <inputEntry id="UnaryTests_0ecbfsa"><text>[5..8]</text></inputEntry>
        <outputEntry id="LiteralExpression_1lqrlvt"><text>"Steak"</text></outputEntry>
      </rule>
      <rule id="row-495762709-5">
        <description>Less effort</description>
        <inputEntry id="UnaryTests_0mtwzqz"><text>"Fall","Winter","Spring"</text></inputEntry>
        <inputEntry id="UnaryTests_0d9uxlp"><text>&gt; 8</text></inputEntry>
        <outputEntry id="LiteralExpression_0mtwzqz"><text>"Stew"</text></outputEntry>
      </rule>
      <rule id="row-495762709-6">
        <description>Hey, why not?</description>
        <inputEntry id="UnaryTests_1uoxwc4"><text>"Summer"</text></inputEntry>
        <inputEntry id="UnaryTests_0e5ky9n"><text>-</text></inputEntry>
        <outputEntry id="LiteralExpression_1uoxwc4"><text>"Light Salad and a nice Steak"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <decision id="season" name="Season">
    <informationRequirement id="InformationRequirement_3">
      <requiredInput href="#temperature"/>
    </informationRequirement>
    <decisionTable id="seasonTable">
      <input id="Input_1" label="Weather in Celsius">
        <inputExpression id="InputExpression_1" typeRef="integer">
          <text>temperature</text>
        </inputExpression>
      </input>
      <output id="Output_1" name="season" typeRef="string"/>
      <rule id="row-495762709-7">
        <inputEntry id="UnaryTests_1nxcsjr"><text>&gt;30</text></inputEntry>
        <outputEntry id="LiteralExpression_0he1witi"><text>"Summer"</text></outputEntry>
      </rule>
      <rule id="row-495762709-8">
        <inputEntry id="UnaryTests_1oa93kk"><text>&lt;10</text></inputEntry>
        <outputEntry id="LiteralExpression_0nhcrpg2"><text>"Winter"</text></outputEntry>
      </rule>
      <rule id="row-495762709-9">
        <inputEntry id="UnaryTests_1qtvyzn"><text>[10..30]</text></inputEntry>
        <outputEntry id="LiteralExpression_0nhcrpg3"><text>"Spring"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <decision id="guestCount" name="Guest Count">
    <informationRequirement id="InformationRequirement_4">
      <requiredInput href="#dayType"/>
    </informationRequirement>
    <decisionTable id="guestCountTable" hitPolicy="UNIQUE">
      <input id="InputClause_0frwyokh" label="Type of day">
        <inputExpression id="LiteralExpression_1qsyi4s" typeRef="string">
          <text>dayType</text>
        </inputExpression>
      </input>
      <output id="OutputClause_1fzsag3" name="guestCount" typeRef="integer"/>
      <rule id="row-495762709-10">
        <inputEntry id="UnaryTests_0nby2ge"><text>"Weekday"</text></inputEntry>
        <outputEntry id="LiteralExpression_1qsyi4s2"><text>4</text></outputEntry>
      </rule>
      <rule id="row-495762709-11">
        <inputEntry id="UnaryTests_1sjmwsr"><text>"Holiday"</text></inputEntry>
        <outputEntry id="LiteralExpression_0nby2ge"><text>10</text></outputEntry>
      </rule>
      <rule id="row-495762709-12">
        <inputEntry id="UnaryTests_1lqrlvt2"><text>"Weekend"</text></inputEntry>
        <outputEntry id="LiteralExpression_1sjmwsr"><text>15</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <inputData id="dayType" name="dayType"/>
  <inputData id="temperature" name="temperature"/>

  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1">
      <dmndi:DMNShape id="DMNShape_1" dmnElementRef="dish-decision">
        <dc:Bounds height="80" width="180" x="160" y="100"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_2" dmnElementRef="season">
        <dc:Bounds height="80" width="180" x="60" y="240"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
