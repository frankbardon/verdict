        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "feel",
        "name"
      ],
      "type": "object"
    },
    "AgentDecision": {
      "additionalProperties": false,
      "properties": {
        "input_bindings": {
          "description": "The only values the agent sees. The model context is never passed through; each binding names a value and the FEEL expression producing it.",
